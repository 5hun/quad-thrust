{
  "name": "hover-browser",
  "version": "1.0.0",
  "description": "\u63d0\u4f9b\u3055\u308c\u305f `HOVER_SOURCE` \u3068 `HOVER120/HOVER.PAC` \u3092\u3082\u3068\u306b\u3057\u305f\u30d6\u30e9\u30a6\u30b6\u79fb\u690d\u3067\u3059\u3002\u524d\u7248\u306e Canvas 2D \u7591\u4f3c3D\u3092\u64a4\u53bb\u3057\u3001**Three.js r180 / WebGL 2** \u306b\u5909\u66f4\u3057\u307e\u3057\u305f\u3002",
  "scripts": {
    "prepare": "husky",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node tests/test-assets.cjs && node tests/test-training.cjs && node tests/test.cjs && node tests/test-fidelity.cjs && node tests/test-circuits.cjs && node tests/test-replay.cjs && node tests/test-input-replay.cjs && node tests/test-card-data.cjs && node tests/test-gp-record-sequence.cjs",
    "start": "python3 start-server.py",
    "lint": "eslint src tests/*.cjs eslint.config.mjs --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "node tests/test-browser-fidelity.cjs",
    "test:menu": "node tests/test-browser-menu.cjs",
    "test:postrace": "node tests/test-browser-postrace.cjs",
    "test:credits": "node tests/test-browser-credits.cjs",
    "test:phases": "node tests/test-browser-race-phases.cjs",
    "test:attract": "node tests/test-browser-attract.cjs",
    "test:help": "node tests/test-browser-help.cjs",
    "test:replay": "node tests/test-browser-replay.cjs",
    "test:ghost": "node tests/test-browser-ghost.cjs",
    "test:card": "node tests/test-browser-card.cjs",
    "test:source-geometry": "npm run build && python3 tools/verify_track_geometry.py",
    "test:source-walls": "npm run build && python3 tools/verify_wall_physics.py",
    "test:source-hover": "npm run build && python3 tools/verify_hover_physics.py",
    "test:source-attitude": "npm run build && python3 tools/verify_attitude.py"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
